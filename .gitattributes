###############################################################################
# 基本ポリシー：テキストは LF、UTF-8（BOMなし）に統一
#  - Windows でも差分が安定します
#  - CRLF を必要とする拡張子は後段で例外指定
###############################################################################
*               text=auto eol=lf

# 明示：Markdown・テキストはUTF-8＋LF
*.md            text working-tree-encoding=UTF-8 eol=lf
*.markdown      text working-tree-encoding=UTF-8 eol=lf
*.txt           text working-tree-encoding=UTF-8 eol=lf
*.csv           text working-tree-encoding=UTF-8 eol=lf
*.tsv           text working-tree-encoding=UTF-8 eol=lf
*.json          text working-tree-encoding=UTF-8 eol=lf
*.yml           text working-tree-encoding=UTF-8 eol=lf
*.yaml          text working-tree-encoding=UTF-8 eol=lf

# シェル/スクリプト（UNIX系）— LF
*.sh            text eol=lf
*.bash          text eol=lf
*.py            text eol=lf
*.rb            text eol=lf
*.pl            text eol=lf

# Windows スクリプトは CRLF（実行互換のため）
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf
*.psm1          text eol=crlf

###############################################################################
# Obsidian 専用：衝突回避・見やすい差分
###############################################################################
# Obsidian の UI 状態ファイルはマージ対象外（常に現在のブランチを優先）
#   - 衝突しやすく価値が低いので binary 扱いでマージを止める
.obsidian/workspace*.json   -text -diff -merge
.obsidian/graph.json        -text -diff -merge
.obsidian/app.json          -text -diff -merge

# Canvas / Excalidraw はJSONだが差分がノイズ化しやすい → バイナリ扱い推奨
*.canvas        -text -diff -merge
*.excalidraw    -text -diff -merge
# プラグイン本体（配布用）はテキスト差分OK
.obsidian/plugins/*/manifest.json   text eol=lf
.obsidian/plugins/*/main.js         text eol=lf
.obsidian/plugins/*/styles.css      text eol=lf
# プラグインの cache/ や data.json は repo では無視（.gitignore 側）を推奨

# CSS スニペット（共有前提）
.obsidian/snippets/**       text eol=lf

###############################################################################
# バイナリ（差分・改行変換をしない）
###############################################################################
# 画像
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.bmp           binary
*.tiff          binary
*.webp          binary
# テキストだが改行変換なしを推奨（最適化ツール併用想定）
*.svg           -text

# ドキュメント／アーカイブ／メディア
*.pdf           binary
*.zip           binary
*.7z            binary
*.rar           binary
*.tar           binary
*.gz            binary
*.bz2           binary
*.xz            binary
*.mp3           binary
*.wav           binary
*.m4a           binary
*.mp4           binary
*.mov           binary
*.avi           binary

# Office / Visio
*.doc           binary
*.docx          binary
*.ppt           binary
*.pptx          binary
*.xls           binary
*.xlsx          binary
*.vsd           binary
*.vsdx          binary
###############################################################################
# 開発補助（必要に応じて）
###############################################################################
# Markdown の見出しを hunk header にする（差分の可読性UP）
# → 併せて .git/config で diff.driver を定義（下に例あり）
*.md            diff=markdown

# 大容量の一時生成物（念のため）
*.bin           binary
*.dat           binary
*.lock          -text -diff
